NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://www.farpi.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
FARPI_TIME_ZONE=Europe/Madrid

# --- Documentos en Google Drive -------------------------------------------
# Credenciales del cliente OAuth (tipo "Aplicación web") de Google Cloud.
# GOOGLE_REDIRECT_URI tiene que estar registrada **tal cual** en la consola:
# Google compara la cadena entera, así que un preview de Vercel con URL
# aleatoria no puede conectar. Solo producción y localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.farpi.app/api/documents/providers/google/callback
# Clave para cifrar los tokens de Drive antes de guardarlos (AES-256-GCM).
# 32 bytes en hex o base64:  openssl rand -hex 32
# Si se pierde, las conexiones guardadas dejan de poder descifrarse y toda la
# familia tiene que volver a conectar su Drive. No caduca; rotarla obliga a eso.
DOCS_TOKEN_KEY=
